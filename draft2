def kelompok_anuitas_khusus():
    while True:
        clear_screen()
        print_header()
        print(Fore.MAGENTA + "📒 KELOMPOK 6 - ANUITAS KHUSUS")
        print_line()
        print(Fore.WHITE + "DESKRIPSI:")
        print(Fore.BLUE + "   → Growing annuity, continuous annuity")
        print(Fore.BLUE + "   → Valuasi dengan inflasi atau arus kas meningkat")
        print_line()
        print(Fore.CYAN + "SUB MENU:")
        print(" 1. Anuitas dengan pertumbuhan (growing)")
        print(" 2. Anuitas kontinyu")
        print(Fore.RED + " 0. Kembali ke menu utama")
        print_line()
        pilih = input(Fore.YELLOW + "Pilih sub-menu [0-2]: " + Style.RESET_ALL)
        
        if pilih == "0":
            break
        elif pilih == "1":
            clear_screen()
            print_header()
            print(Fore.MAGENTA + "📒 ANUITAS DENGAN PERTUMBUHAN")
            print_line()
            print_info("Rumus: PV = R1 × (1 - ((1+g)/(1+i))^n) / (i - g)")
            print_line()
            R1 = float(input("Pembayaran pertama: Rp "))
            i = float(input("Tingkat bunga per periode (%): ")) / 100
            g = float(input("Tingkat pertumbuhan (%): ")) / 100
            n = int(input("Jumlah periode: "))
            if i == g:
                PV = R1 * n / (1 + i)
            else:
                PV = R1 * (1 - ((1 + g) / (1 + i)) ** n) / (i - g)
            print_line()
            print_result("Nilai Sekarang", f"Rp {PV:,.0f}")
            pause()
        elif pilih == "2":
            clear_screen()
            print_header()
            print(Fore.MAGENTA + "📒 ANUITAS KONTINYU")
            print_line()
            print_info("Rumus: PV = R × (1 - e^(-δn)) / δ, dengan δ = ln(1+i)")
            print_line()
            R = float(input("Total pembayaran per tahun: Rp "))
            i = float(input("Tingkat bunga (%): ")) / 100
            n = int(input("Jumlah tahun: "))
            delta = math.log(1 + i)
            PV = R * (1 - math.exp(-delta * n)) / delta
            print_line()
            print_result("Nilai Sekarang", f"Rp {PV:,.0f}")
            pause()

