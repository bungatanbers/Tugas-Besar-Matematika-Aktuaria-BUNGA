# KELOMPOK 4 - PERSAMAAN NILAI & NPV
# ============================================================
def kelompok_persamaan_nilai():
    while True:
        clear_screen()
        print_header()
        print(Fore.MAGENTA + "📕 KELOMPOK 4 - PERSAMAAN NILAI & NPV")
        print_line()
        print(Fore.WHITE + "DESKRIPSI:")
        print(Fore.BLUE + "   → NPV, IRR, pembayaran tunggal pengganti utang")
        print(Fore.BLUE + "   → Analisis kelayakan proyek & investasi")
        print_line()
        print(Fore.CYAN + "SUB MENU:")
        print(" 1. NPV (Net Present Value)")
        print(" 2. IRR (Internal Rate of Return)")
        print(" 3. Pembayaran tunggal pengganti utang")
        print(Fore.RED + " 0. Kembali ke menu utama")
        print_line()
        pilih = input(Fore.YELLOW + "Pilih sub-menu [0-3]: " + Style.RESET_ALL)
        
        if pilih == "0":
            break
        elif pilih == "1":
            clear_screen()
            print_header()
            print(Fore.MAGENTA + "📕 NPV (NET PRESENT VALUE)")
            print_line()
            print_info("Rumus: NPV = Σ CFt / (1+i)^t")
            print_line()
            cf0 = float(input("Investasi awal (negatif): Rp "))
            n = int(input("Jumlah periode arus kas: "))
            cf = []
            for i in range(1, n + 1):
                cf.append(float(input(f"Arus kas tahun ke-{i}: Rp ")))
            i = float(input("Tingkat diskonto (%): ")) / 100
            npv = cf0
            for t, cash in enumerate(cf, start=1):
                npv += cash / (1 + i) ** t
            print_line()
            print_result("NPV", f"Rp {npv:,.0f}")
            if npv > 0:
                print_success("Proyek LAYAK (NPV positif)")
            elif npv < 0:
                print_error("Proyek TIDAK LAYAK (NPV negatif)")
            else:
                print_info("Proyek impas (NPV = 0)")
            pause()
        elif pilih == "2":
            clear_screen()
            print_header()
            print(Fore.MAGENTA + "📕 IRR (INTERNAL RATE OF RETURN)")
            print_line()
            print_info("Metode: Trial & error (estimasi)")
            print_line()
            cf0 = float(input("Investasi awal (negatif): Rp "))
            n = int(input("Jumlah periode: "))
            cf = []
            for i in range(1, n + 1):
                cf.append(float(input(f"Arus kas tahun ke-{i}: Rp ")))
            
            def npv(rate):
                result = cf0
                for t, cash in enumerate(cf, start=1):
                    result += cash / (1 + rate) ** t
                return result
            
            guess = 0.1
            for _ in range(30):
                if npv(guess) > 0:
                    guess += 0.01
                else:
                    guess -= 0.001
            print_line()
            print_result("Estimasi IRR", f"{guess * 100:.2f}%")
            pause()
        elif pilih == "3":
            clear_screen()
            print_header()
            print(Fore.MAGENTA + "📕 PEMBAYARAN TUNGGAL PENGGANTI UTANG")
            print_line()
            print_info("Prinsip: Nilai utang = Nilai pembayaran baru pada tanggal fokus")
            print_line()
            n = int(input("Jumlah utang: "))
            utang = []
            tahun = []
            for i in range(n):
                print(Fore.CYAN + f"Utang ke-{i+1}:")
                u = float(input("  Nilai utang: Rp "))
                t = float(input("  Jatuh tempo (tahun): "))
                utang.append(u)
                tahun.append(t)
            i = float(input("Tingkat bunga (%): ")) / 100
            t_fokus = float(input("Tanggal fokus (tahun): "))
            
            total = 0
            for u, t in zip(utang, tahun):
                total += u * (1 + i) ** (t_fokus - t)
            print_line()
            print_result(f"Pembayaran tunggal pada tahun ke-{t_fokus}", f"Rp {total:,.0f}")
            pause()

