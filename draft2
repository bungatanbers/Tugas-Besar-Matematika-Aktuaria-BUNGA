        print_line()
        print(Fore.CYAN + "SUB MENU:")
        print(" 1. Premi asuransi berjangka (diskrit)")
        print(" 2. Premi asuransi seumur hidup")
        print(" 3. Premi asuransi dwiguna (endowment)")
        print(" 4. Premi asuransi kontinyu")
        print(" 5. Premi tahunan dari premi tunggal")
        print(Fore.RED + " 0. Kembali ke menu utama")
        print_line()
        pilih = input(Fore.YELLOW + "Pilih sub-menu [0-5]: " + Style.RESET_ALL)
        
        if pilih == "0":
            break
        elif pilih == "1":
            clear_screen()
            print_header()
            print(Fore.MAGENTA + "🛡️ PREMI ASURANSI BERJANGKA")
            print_line()
            print_info("Asumsi: qx = 0.01, bunga = 6%")
            print_info("Rumus: A = Σ v^(k+1) × k|qx")
            print_line()
            x = int(input("Usia tertanggung: "))
            n = int(input("Jangka waktu (tahun): "))
            manfaat = float(input("Manfaat asuransi: Rp "))
            i = 0.06
            q = 0.01
            v = 1 / (1 + i)
            A = 0
            for k in range(n):
                A += v ** (k + 1) * q * (1 - q) ** k
            premi = manfaat * A
            print_line()
            print_result("Premi bersih tunggal", f"Rp {premi:,.0f}")
            pause()
        elif pilih == "2":
            clear_screen()
            print_header()
            print(Fore.MAGENTA + "🛡️ PREMI ASURANSI SEUMUR HIDUP")
            print_line()
            print_info("Asumsi: qx = 0.01, bunga = 6%")
            print_info("Rumus: A = Σ_(k=0)^∞ v^(k+1) × k|qx")
            print_line()
            x = int(input("Usia tertanggung: "))
            manfaat = float(input("Manfaat asuransi: Rp "))
            i = 0.06
            q = 0.01
            v = 1 / (1 + i)
            A = 0
            for k in range(100 - x):
                A += v ** (k + 1) * q * (1 - q) ** k
            premi = manfaat * A
            print_line()
            print_result("Premi bersih tunggal", f"Rp {premi:,.0f}")
            pause()
        elif pilih == "3":
            clear_screen()
            print_header()
            print(Fore.MAGENTA + "🛡️ PREMI ASURANSI DWIGUNA")
            print_line()
            print_info("Asumsi: qx = 0.01, bunga = 6%")
            print_info("Rumus: A = A_berjangka + v^n × npx")
            print_line()
            x = int(input("Usia tertanggung: "))
            n = int(input("Jangka waktu (tahun): "))
            manfaat = float(input("Manfaat asuransi: Rp "))
            i = 0.06
            q = 0.01
            v = 1 / (1 + i)
            A_term = 0
            for k in range(n):
                A_term += v ** (k + 1) * q * (1 - q) ** k
            npx = (1 - q) ** n
            A_endow = v ** n * npx
            A_total = A_term + A_endow
            premi = manfaat * A_total
            print_line()
            print_result("Premi bersih tunggal", f"Rp {premi:,.0f}")
            pause()
        elif pilih == "4":
            clear_screen()
            print_header()
            print(Fore.MAGENTA + "🛡️ PREMI ASURANSI KONTINYU")
            print_line()
            print_info("Asumsi: μ = 0.01, δ = ln(1.06)")
            print_info("Rumus: Ā = μ/(μ+δ) × (1 - e^(-(μ+δ)n))")
            print_line()
            manfaat = float(input("Manfaat asuransi: Rp "))
            n = int(input("Jangka waktu (0 = seumur hidup): "))
            delta = math.log(1.06)
            mu = 0.01
            if n == 0:
                A_bar = mu / (mu + delta)
            else:
                A_bar = mu / (mu + delta) * (1 - math.exp(-(mu + delta) * n))
            premi = manfaat * A_bar
            print_line()
            print_result("Premi bersih tunggal", f"Rp {premi:,.0f}")
            pause()
        elif pilih == "5":
            clear_screen()
            print_header()
            print(Fore.MAGENTA + "🛡️ PREMI TAHUNAN")
            print_line()
            print_info("Rumus: P = A / ä, dengan ä = anuitas hidup due")
            print_info("Asumsi: ä = 10 (contoh sederhana)")
            print_line()
            A = float(input("Premi bersih tunggal: Rp "))
            a_double_dot = 10
            P = A / a_double_dot
            print_line()
            print_result("Premi tahunan", f"Rp {P:,.0f}")
            pause()

