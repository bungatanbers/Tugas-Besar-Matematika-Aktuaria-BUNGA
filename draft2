# KELOMPOK 3 - BUNGA NOMINAL & KONTINYU
# ============================================================
def kelompok_bunga_nominal():
    while True:
        clear_screen()
        print_header()
        print(Fore.MAGENTA + "📗 KELOMPOK 3 - BUNGA NOMINAL & KONTINYU")
        print_line()
        print(Fore.WHITE + "DESKRIPSI:")
        print(Fore.BLUE + "   → Konversi i(m)→i efektif, d(m)→i, kekuatan bunga (δ)")
        print(Fore.BLUE + "   → Analisis bunga frekuensi tinggi & continuous compounding")
        print_line()
        print(Fore.CYAN + "SUB MENU:")
        print(" 1. Konversi i(m) → i efektif")
        print(" 2. Konversi d(m) → i efektif")
        print(" 3. Kekuatan bunga (δ) & kontinyu")
        print(Fore.RED + " 0. Kembali ke menu utama")
        print_line()
        pilih = input(Fore.YELLOW + "Pilih sub-menu [0-3]: " + Style.RESET_ALL)
        
        if pilih == "0":
            break
        elif pilih == "1":
            clear_screen()
            print_header()
            print(Fore.MAGENTA + "📗 KONVERSI i(m) → i EFEKTIF")
            print_line()
            print_info("Rumus: i_eff = (1 + i(m)/m)^m - 1")
            print_line()
            i_nom = float(input("Tingkat bunga nominal i(m) (%): ")) / 100
            print(Fore.CYAN + "Frekuensi konversi (m):")
            print(" 1. Tahunan (m=1)  2. Semesteran (m=2)")
            print(" 3. Triwulanan (m=4)  4. Bulanan (m=12)")
            m_choice = input(Fore.YELLOW + "Pilih [1-4]: " + Style.RESET_ALL)
            m_map = {"1": 1, "2": 2, "3": 4, "4": 12}
            m = m_map.get(m_choice, 1)
            i_eff = ((1 + i_nom / m) ** m - 1) * 100
            print_line()
            print_result("Tingkat bunga efektif", f"{i_eff:.4f}% per tahun")
            pause()
        elif pilih == "2":
            clear_screen()
            print_header()
            print(Fore.MAGENTA + "📗 KONVERSI d(m) → i EFEKTIF")
            print_line()
            print_info("Rumus: i_eff = (1 - d(m)/m)^(-m) - 1")
            print_line()
            d_nom = float(input("Tingkat diskonto nominal d(m) (%): ")) / 100
            print(Fore.CYAN + "Frekuensi konversi (m):")
            print(" 1. Tahunan (m=1)  2. Semesteran (m=2)")
            print(" 3. Triwulanan (m=4)  4. Bulanan (m=12)")
            m_choice = input(Fore.YELLOW + "Pilih [1-4]: " + Style.RESET_ALL)
            m_map = {"1": 1, "2": 2, "3": 4, "4": 12}
            m = m_map.get(m_choice, 1)
            i_eff = ((1 - d_nom / m) ** (-m) - 1) * 100
            print_line()
            print_result("Tingkat bunga efektif", f"{i_eff:.4f}% per tahun")
            pause()
        elif pilih == "3":
            clear_screen()
            print_header()
            print(Fore.MAGENTA + "📗 KEKUATAN BUNGA (δ) & KONTINYU")
            print_line()
            print_info("Rumus: δ = ln(1+i), A = P·e^(δt)")
            print_line()
            print(Fore.CYAN + "Pilih:")
            print(" 1. i → δ (kekuatan bunga)")
            print(" 2. δ → i (bunga efektif)")
            print(" 3. Nilai akumulasi kontinyu")
            sub = input(Fore.YELLOW + "Pilih [1-3]: " + Style.RESET_ALL)
            if sub == "1":
                i = float(input("Tingkat bunga i (%): ")) / 100
                delta = math.log(1 + i) * 100
                print_line()
                print_result("Kekuatan bunga δ", f"{delta:.4f}%")
            elif sub == "2":
                delta = float(input("Kekuatan bunga δ (%): ")) / 100
                i = (math.exp(delta) - 1) * 100
                print_line()
                print_result("Tingkat bunga i", f"{i:.4f}%")
            elif sub == "3":
                P = float(input("Pokok (P): Rp "))
                delta = float(input("Kekuatan bunga δ (%): ")) / 100
                t = float(input("Waktu (tahun): "))
                A = P * math.exp(delta * t)
                print_line()
                print_result("Nilai akumulasi", f"Rp {A:,.0f}")
            pause()

