def kelompok_anuitas():
    while True:
        clear_screen()
        print_header()
        print(Fore.MAGENTA + "📔 KELOMPOK 5 - ANUITAS")
        print_line()
        print(Fore.WHITE + "DESKRIPSI:")
        print(Fore.BLUE + "   → Anuitas immediate & due, mencari R/n, amortisasi, perpetuitas")
        print(Fore.BLUE + "   → KPR, kredit, dana pensiun")
        print_line()
        print(Fore.CYAN + "SUB MENU:")
        print(" 1. Anuitas Immediate")
        print(" 2. Anuitas Due")
        print(" 3. Mencari pembayaran (R) atau periode (n)")
        print(" 4. Tabel Amortisasi Pinjaman")
        print(" 5. Perpetuitas (biasa & ditunda)")
        print(Fore.RED + " 0. Kembali ke menu utama")
        print_line()
        pilih = input(Fore.YELLOW + "Pilih sub-menu [0-5]: " + Style.RESET_ALL)
        
        if pilih == "0":
            break
        elif pilih == "1":
            clear_screen()
            print_header()
            print(Fore.MAGENTA + "📔 ANUITAS IMMEDIATE")
            print_line()
            print_info("Pembayaran di AKHIR periode")
            print_info("Rumus PV = R × (1 - (1+i)^-n)/i")
            print_info("Rumus FV = R × ((1+i)^n - 1)/i")
            print_line()
            print(Fore.CYAN + "1. Nilai Sekarang (PV)")
            print("2. Nilai Akumulasi (FV)")
            sub = input(Fore.YELLOW + "Pilih [1-2]: " + Style.RESET_ALL)
            R = float(input("Pembayaran periodik (R): Rp "))
            i = float(input("Tingkat bunga per periode (%): ")) / 100
            n = int(input("Jumlah periode: "))
            if sub == "1":
                PV = R * (1 - (1 + i) ** -n) / i
                print_line()
                print_result("Nilai Sekarang", f"Rp {PV:,.0f}")
            else:
                FV = R * ((1 + i) ** n - 1) / i
                print_line()
                print_result("Nilai Akumulasi", f"Rp {FV:,.0f}")
            pause()
        elif pilih == "2":
            clear_screen()
            print_header()
            print(Fore.MAGENTA + "📔 ANUITAS DUE")
            print_line()
            print_info("Pembayaran di AWAL periode")
            print_info("Rumus PV = R × (1 - (1+i)^-n)/d, dengan d = i/(1+i)")
            print_line()
            print(Fore.CYAN + "1. Nilai Sekarang (PV)")
            print("2. Nilai Akumulasi (FV)")
            sub = input(Fore.YELLOW + "Pilih [1-2]: " + Style.RESET_ALL)
            R = float(input("Pembayaran periodik (R): Rp "))
            i = float(input("Tingkat bunga per periode (%): ")) / 100
            n = int(input("Jumlah periode: "))
            d = i / (1 + i)
            if sub == "1":
                PV = R * (1 - (1 + i) ** -n) / d
                print_line()
                print_result("Nilai Sekarang", f"Rp {PV:,.0f}")
            else:
                FV = R * ((1 + i) ** n - 1) / d
                print_line()
                print_result("Nilai Akumulasi", f"Rp {FV:,.0f}")
            pause()
        elif pilih == "3":
            clear_screen()
            print_header()
            print(Fore.MAGENTA + "📔 MENCARI R ATAU n")
            print_line()
            print(Fore.CYAN + "1. Mencari R dari PV")
            print("2. Mencari n dari PV")
            sub = input(Fore.YELLOW + "Pilih [1-2]: " + Style.RESET_ALL)
            i = float(input("Tingkat bunga per periode (%): ")) / 100
            if sub == "1":
                PV = float(input("Nilai Sekarang (PV): Rp "))
                n = int(input("Jumlah periode: "))
                R = PV * i / (1 - (1 + i) ** -n)
                print_line()
                print_result("Pembayaran periodik (R)", f"Rp {R:,.0f}")
            elif sub == "2":
                PV = float(input("Nilai Sekarang (PV): Rp "))
                R = float(input("Pembayaran periodik (R): Rp "))
                a_n = PV / R
                n = -math.log(1 - a_n * i) / math.log(1 + i)
                print_line()
                print_result("Jumlah periode (n)", f"{n:.2f}")
            pause()
        elif pilih == "4":
            clear_screen()
            print_header()
            print(Fore.MAGENTA + "📔 TABEL AMORTISASI PINJAMAN")
            print_line()
            P = float(input("Pokok pinjaman: Rp "))
            i = float(input("Tingkat bunga per periode (%): ")) / 100
            n = int(input("Jumlah periode: "))
            R = P * i / (1 - (1 + i) ** -n)
            print_line()
            print(Fore.GREEN + f"Angsuran per periode = Rp {R:,.0f}")
            print_line()
            print(Fore.CYAN + f"{'Periode':^8} | {'Pembayaran':^12} | {'Bunga':^10} | {'Pokok':^10} | {'Sisa Utang':^12}")
            print(Fore.CYAN + "-" * 65)
            sisa = P
            for t in range(1, n + 1):
                bunga = sisa * i
                pokok = R - bunga
                sisa -= pokok
                print(f"{t:^8} | {R:12,.0f} | {bunga:10,.0f} | {pokok:10,.0f} | {sisa:12,.0f}")
            pause()
        elif pilih == "5":
