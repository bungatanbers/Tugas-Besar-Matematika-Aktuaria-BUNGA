import math
import os 
from colorama import init, Fore, Back, Style
init(autoreset=True)

def clear_screen():
    os.system('cls' if os.name == 'nt' else 'clear')

def print_header():
    width = 80
    print(Fore.CYAN + "╔" + "═" * width + "╗")
    print(Fore.CYAN + "║" + Fore.YELLOW + "KALKULATOR KEUANGAN & AKTUARIA".center(width) + Fore.CYAN + "║")
    print(Fore.CYAN + "║" + Fore.WHITE + "Financial Calculator".center(width) + Fore.CYAN + "║")
    print(Fore.CYAN + "╚" + "═" * width + "╝")
    print()

def print_line():
    print(Fore.CYAN + "─" * 70)

def print_success(msg):
    print(Fore.GREEN + "✓ " + msg)

def print_error(msg):
    print(Fore.RED + "✗ " + msg)

def print_info(msg):
    print(Fore.BLUE + "ℹ " + msg)

def print_result(label, value):
    print(Fore.GREEN + f"📌 {label}: " + Fore.YELLOW + f"{value}")

def pause():
    input(Fore.LIGHTBLUE_EX + "\nTekan Enter untuk kembali ke menu..." + Style.RESET_ALL)

# ============================================================
# KELOMPOK 1 - BUNGA & NILAI WAKTU UANG
# ============================================================
def kelompok_bunga():
    while True:
        clear_screen()
        print_header()
        print(Fore.LIGHTRED_EX + "📘 BUNGA & NILAI WAKTU UANG")
        print_line()
        print(Fore.WHITE + "DESKRIPSI:")
        print(Fore.WHITE + "   → Bunga sederhana, bunga majemuk, nilai akumulasi, mencari P,i,t")
        print(Fore.WHITE + "   → Deposito, tabungan, pinjaman sederhana")
        print_line()
        print(Fore.CYAN + "SUB MENU:")
        print(" 1. Bunga Sederhana")
        print(" 2. Bunga Majemuk (tahunan)")
        print(" 3. Bunga Majemuk (m-kali setahun)")
        print(" 4. Mencari P / i / t (bunga sederhana)")
        print(Fore.RED + " 0. Kembali ke menu utama")
        print_line()
        pilih = input(Fore.YELLOW + "Pilih sub-menu [0-4]: " + Style.RESET_ALL)
        
        if pilih == "0":
            break
        elif pilih == "1":
            clear_screen()
            print_header()
            print(Fore.MAGENTA + "📘 BUNGA SEDERHANA")
            print_line()
            print_info("Rumus: I = P × i × t, A = P + I")
            print_line()
            P = float(input("Pokok (P): Rp "))
            i = float(input("Tingkat bunga per tahun (%): ")) / 100
            t = float(input("Waktu (tahun): "))
            I = P * i * t
            A = P + I
            print_line()
            print_result("Bunga (I)", f"Rp {I:,.0f}")
            print_result("Nilai Akumulasi (A)", f"Rp {A:,.0f}")
            pause()
        elif pilih == "2":
            clear_screen()
            print_header()
            print(Fore.MAGENTA + "📘 BUNGA MAJEMUK (TAHUNAN)")
            print_line()
            print_info("Rumus: A = P(1 + i)^n")
            print_line()
            P = float(input("Pokok (P): Rp "))
            i = float(input("Tingkat bunga (% per tahun): ")) / 100
            n = int(input("Jumlah tahun: "))
            A = P * (1 + i) ** n
            print_line()
            print_result("Nilai Akumulasi", f"Rp {A:,.0f}")
            pause()
        elif pilih == "3":
            clear_screen()
            print_header()
            print(Fore.MAGENTA + "📘 BUNGA MAJEMUK (m-KALI SETAHUN)")
            print_line()
            print_info("Rumus: A = P(1 + i(m)/m)^(m×t)")
            print_line()
            P = float(input("Pokok (P): Rp "))
            i_nom = float(input("Tingkat bunga nominal (% per tahun): ")) / 100
            print(Fore.CYAN + "Frekuensi konversi:")
            print(" 1. Tahunan (m=1)")
            print(" 2. Semesteran (m=2)")
            print(" 3. Triwulanan (m=4)")
            print(" 4. Bulanan (m=12)")
            m_choice = input(Fore.YELLOW + "Pilih [1-4]: " + Style.RESET_ALL)
            m_map = {"1": 1, "2": 2, "3": 4, "4": 12}
            m = m_map.get(m_choice, 1)
            t = float(input("Waktu (tahun): "))
            A = P * (1 + i_nom / m) ** (m * t)
            print_line()
            print_result("Nilai Akumulasi", f"Rp {A:,.0f}")
            pause()
        elif pilih == "4":
            clear_screen()
            print_header()
            print(Fore.MAGENTA + "📘 MENCARI P / i / t (BUNGA SEDERHANA)")
            print_line()
            print_info("Rumus: P = A/(1+i×t), i = (A-P)/(P×t), t = (A-P)/(P×i)")
            print_line()
            print(Fore.CYAN + "Cari:")
            print(" 1. Pokok (P)")
            print(" 2. Tingkat bunga (i)")
            print(" 3. Waktu (t)")
            sub = input(Fore.YELLOW + "Pilih [1-3]: " + Style.RESET_ALL)
            if sub == "1":
                A = float(input("Nilai Akumulasi (A): Rp "))
                i = float(input("Tingkat bunga (%): ")) / 100
                t = float(input("Waktu (tahun): "))
                P = A / (1 + i * t)
                print_line()
                print_result("Pokok (P)", f"Rp {P:,.0f}")
            elif sub == "2":
                P = float(input("Pokok (P): Rp "))
                A = float(input("Nilai Akumulasi (A): Rp "))
                t = float(input("Waktu (tahun): "))
                i = (A - P) / (P * t) * 100
                print_line()
                print_result("Tingkat bunga (i)", f"{i:.2f}% per tahun")
            elif sub == "3":
                P = float(input("Pokok (P): Rp "))
                A = float(input("Nilai Akumulasi (A): Rp "))
                i = float(input("Tingkat bunga (%): ")) / 100
                t = (A - P) / (P * i)
                print_line()
                print_result("Waktu (t)", f"{t:.2f} tahun")
            pause()

# ============================================================
# KELOMPOK 2 - NILAI SEKARANG & DISKONTO
# ============================================================
def kelompok_nilai_sekarang():
    while True:
        clear_screen()
        print_header()
        print(Fore.MAGENTA + "📙 KELOMPOK 2 - NILAI SEKARANG & DISKONTO")
        print_line()
        print(Fore.WHITE + "DESKRIPSI:")
        print(Fore.BLUE + "   → PV dari FV, konversi i↔d, diskonto wesel/SBI")
        print(Fore.BLUE + "   → Valuasi aset & instrumen diskonto")
        print_line()
        print(Fore.CYAN + "SUB MENU:")
        print(" 1. Nilai Sekarang (PV) dari FV")
        print(" 2. Konversi i ↔ d (tingkat diskonto efektif)")
        print(" 3. Diskonto Wesel / SBI")
        print(Fore.RED + " 0. Kembali ke menu utama")
        print_line()
        pilih = input(Fore.YELLOW + "Pilih sub-menu [0-3]: " + Style.RESET_ALL)
        
        if pilih == "0":
            break
        elif pilih == "1":
            clear_screen()
            print_header()
            print(Fore.MAGENTA + "📙 NILAI SEKARANG (PV) dari FV")
            print_line()
            print_info("Rumus: PV = FV / (1 + i)^n")
            print_line()
            FV = float(input("Nilai masa depan (FV): Rp "))
            i = float(input("Tingkat bunga (% per tahun): ")) / 100
            n = int(input("Jumlah tahun: "))
            PV = FV / (1 + i) ** n
            print_line()
            print_result("Nilai Sekarang (PV)", f"Rp {PV:,.0f}")
            pause()
        elif pilih == "2":
            clear_screen()
            print_header()
            print(Fore.MAGENTA + "📙 KONVERSI i ↔ d")
            print_line()
            print_info("Rumus: d = i/(1+i), i = d/(1-d)")
            print_line()
            print(Fore.CYAN + "Pilih konversi:")
            print(" 1. i → d (tingkat diskonto efektif)")
            print(" 2. d → i (tingkat bunga efektif)")
            sub = input(Fore.YELLOW + "Pilih [1-2]: " + Style.RESET_ALL)
            if sub == "1":
                i = float(input("Tingkat bunga i (%): ")) / 100
                d = i / (1 + i) * 100
                print_line()
                print_result("Tingkat diskonto d", f"{d:.4f}%")
            elif sub == "2":
                d = float(input("Tingkat diskonto d (%): ")) / 100
                i = d / (1 - d) * 100
                print_line()
                print_result("Tingkat bunga i", f"{i:.4f}%")
            pause()
        elif pilih == "3":
            clear_screen()
            print_header()
            print(Fore.MAGENTA + "📙 DISKONTO WESEL / SBI")
            print_line()
            print_info("Rumus: Harga = Nominal × (1 - d × t)")
            print_info("Yield = (Nominal - Harga)/(Harga × t) × 100%")
            print_line()
            nominal = float(input("Nilai nominal wesel: Rp "))
            d = float(input("Tingkat diskonto (% per tahun): ")) / 100
            t_hari = float(input("Jatuh tempo (hari): "))
            t = t_hari / 360
            harga = nominal * (1 - d * t)
            yield_rate = (nominal - harga) / (harga * t) * 100
            print_line()
            print_result("Harga wesel", f"Rp {harga:,.0f}")
            print_result("Tingkat bunga efektif (yield)", f"{yield_rate:.2f}%")
            pause()

