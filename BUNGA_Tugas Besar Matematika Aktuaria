        with col2:
            n = st.number_input("Jumlah periode", min_value=1, max_value=60, value=5, step=1, key="amort_n")
        
        if st.button("Buat Tabel Amortisasi", key="btn_amort"):
            R = P * i / (1 - (1 + i) ** -n)
            st.info(f"Angsuran per periode = Rp {R:,.0f}")
            
            data = []
            sisa = P
            for t in range(1, n + 1):
                bunga = sisa * i
                pokok = R - bunga
                sisa -= pokok
                data.append({
                    "Periode": t,
                    "Pembayaran": f"Rp {R:,.0f}",
                    "Bunga": f"Rp {bunga:,.0f}",
                    "Pokok": f"Rp {pokok:,.0f}",
