        if st.button("Hitung Premi Tahunan", key="btn_annual"):
            P = A / a_double_dot
            st.markdown(f"""
            <div class="result-box">
                <p>📌 Premi tahunan: <b>Rp {P:,.0f}</b></p>
            </div>
            """, unsafe_allow_html=True)


