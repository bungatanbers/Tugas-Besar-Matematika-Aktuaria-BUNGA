            if st.button("Hitung Perpetuitas Ditunda", key="btn_perp2"):
                PV = (R / i) / (1 + i) ** t_tunda
                st.markdown(f"""
                <div class="result-box">
                    <p>📌 Nilai Sekarang (ditunda {t_tunda} periode): <b>Rp {PV:,.0f}</b></p>
                </div>
                """, unsafe_allow_html=True)
        
        else:
            with col2:
                g = st.number_input("Tingkat pertumbuhan (%)", min_value=0.0, value=5.0, step=0.5, key="g") / 100
